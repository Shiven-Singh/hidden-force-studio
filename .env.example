# Google Cloud. GOOGLE_GENAI_USE_VERTEXAI=1 routes @google/adk and @google/genai to Vertex.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global   # Gemini 3.x models are served from global, not a region
GOOGLE_GENAI_USE_VERTEXAI=1

# Parallel. Read by parallel-web by default.
PARALLEL_API_KEY=

# Run outputs are also copied here when set.
OUTPUT_BUCKET=

# Model IDs. Pin whatever answers a smoke test in your region.
DRAFT_MODEL=gemini-3.5-flash
REVIEW_MODEL=gemini-3.1-pro-preview   # gemini-2.5-pro is the GA fallback

PORT=8080
# Cost guards. Films per server instance, and new runs per rolling day. The buttons are public.
RENDER_LIMIT=3
RUN_DAILY_CAP=8
