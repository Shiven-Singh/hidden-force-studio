{
  "name": "hfs-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.21.0",
    "@hfs/schemas": "workspace:*",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "parallel-web": "^1.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13"
  }
}
